+
 #endif /* _RWNX_CMDS_H_ */
Index: aic8800/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
===================================================================
--- aic8800.orig/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
+++ aic8800/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_main.c
@@ -8867,6 +8867,19 @@
 
 int rwnx_ic_system_init(struct rwnx_hw *rwnx_hw){
 
+	/* On the DC and DW a USB reset leaves the chip powered and its radio as the stall left it, and the firmware loaded
+	 * afresh then hangs at its first start (2026-10-11). Before anything is started, while it still answers, reboot
+	 * the whole chip: it leaves the bus and comes back, and that probe starts it clean. (A D80 dongle restarts in
+	 * its USB-drive mode after a USB reset: already a whole reboot.) */
+	if (aicwf_reboot_chip_on_probe) {
+		aicwf_reboot_chip_on_probe = false;
+		if ((rwnx_hw->usbdev->chipid == PRODUCT_ID_AIC8800DC || rwnx_hw->usbdev->chipid == PRODUCT_ID_AIC8800DW) &&
+		    !rwnx_send_reboot(rwnx_hw)) {
+			printk(KERN_CRIT "aic8800: rebooted the chip after the reset\n");
+			return -1;
+		}
+	}
+
 	if(rwnx_hw->usbdev->chipid == PRODUCT_ID_AIC8801){
 		system_config(rwnx_hw);
 	}else if(rwnx_hw->usbdev->chipid == PRODUCT_ID_AIC8800DC ||
