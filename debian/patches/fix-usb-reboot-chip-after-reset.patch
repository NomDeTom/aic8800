Description: aic8800_fdrv (USB): after a reset for a firmware that stopped answering, reboot the whole chip before starting it
 A USB reset leaves the chip powered, and in real stalls the firmware loaded afresh hung at its
 first start (DBG_START_APP_REQ unanswered, the probe failed). Debug messages are still answered
 then, so the re-probe asks the chip to reboot (HOST_START_APP_REBOOT) before anything is started;
 the device leaves the bus and comes back, and that probe starts it clean.
Author: NomDeTom
Forwarded: no
Last-Update: 2026-10-21
---
Index: aic8800/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c
===================================================================
--- aic8800.orig/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c
+++ aic8800/src/USB/driver_fw/drivers/aic8800/aic8800_fdrv/rwnx_cmds.c
@@ -39,6 +39,9 @@
            cmd->reqid, cmd->reqid != (lmac_msg_id_t)-1 ? RWNX_ID2STR(cmd->reqid) : "none");
 }
 
+/* Set by a reset for a firmware that stopped answering: the next probe reboots the chip first. */
+bool aicwf_reboot_chip_on_probe;
+
 /* The firmware stopped answering: reset the USB device (the driver probes again and loads the firmware afresh), at
  * most once a minute; asked again by the commands refused meanwhile. */
 static void cmd_mgr_reset_device(struct rwnx_cmd_mgr *cmd_mgr)
@@ -51,6 +54,7 @@
         return;
     last = jiffies;
     printk(KERN_CRIT "aic8800: firmware not answering: resetting the device to load it afresh\n");
+    aicwf_reboot_chip_on_probe = true;
     usb_queue_reset_device(usbdev->intf);
 #endif
 }
